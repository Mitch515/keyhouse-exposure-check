{
  "name": "keyhouse-check",
  "version": "0.1.1",
  "description": "Local Railway and .env secret exposure inventory with provider rotation checklists",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "keyhouse-check": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.gitleaks",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "npm run build && playwright test",
    "lint": "git diff --check"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici-types": "6.21.0"
  }
}
